	"data": "\u003c!DOCTYPE html\u003e\r\n\u003chtml lang=\"id\"\u003e\r\n\u003chead\u003e\r\n    \u003cmeta charset=\"UTF-8\"\u003e\r\n    \u003ctitle\u003eMemo\u003c/title\u003e\r\n    \u003cstyle type=\"text/css\"\u003e\r\n        p {\r\n            line-height: 115%;\r\n            text-align: left;\r\n            margin-bottom: 0.1in;\r\n            direction: ltr;\r\n            background: transparent;\r\n            font-family: \"Arial\", sans-serif;\r\n        }\r\n        p.western {\r\n            font-family: \"Arial\", sans-serif;\r\n        }\r\n        p.cjk {\r\n            font-family: \"Arial\";\r\n        }\r\n        p.ctl {\r\n            font-family: \"Arial\";\r\n        }\r\n\r\n        .logo {\r\n            position: absolute;\r\n            top: 10px;\r\n            right: 10px;\r\n            max-width: 200px;\r\n            margin-bottom: 10%;\r\n        }\r\n\r\n        .memo {\r\n            text-align: center;\r\n            font-family: \"Arial\", sans-serif;\r\n            font-size: 24px;\r\n            font-weight: bold;\r\n            margin-bottom: 20px;\r\n            margin-top: 10%;\r\n        }\r\n\r\n    \r\n        .table {\r\n            width: 90%; \r\n            border-collapse: collapse;\r\n            margin-left: auto;\r\n            margin-right: auto;\r\n            margin-bottom: 30px;\r\n        }\r\n\r\n        .table td {\r\n            padding: 0in 0.08in;\r\n        }\r\n\r\n        .content-text {\r\n            margin-left: 5%;\r\n            margin-right: 5%;\r\n            text-align: justify;\r\n            font-family: \"Arial\", sans-serif;\r\n        }\r\n\r\n        .box-left {\r\n            display: inline-block;\r\n            width: 60px;\r\n            height: 40px;\r\n            background-color: skyblue;\r\n            color: white;\r\n            text-align: center;\r\n            vertical-align: middle;\r\n            line-height: 40px;\r\n        }\r\n\r\n        .box-right {\r\n            display: inline-block;\r\n            width: 60px;\r\n            height: 40px;\r\n            background-color: red;\r\n            color: white;\r\n            text-align: center;\r\n            vertical-align: middle;\r\n            line-height: 40px;\r\n        }\r\n\r\n        .yellow-box {\r\n            width: 80px;\r\n            height: 80px;\r\n            background-color: yellow;\r\n            margin-top: 20px;\r\n            line-height: 40px;\r\n            margin-left: 10%;\r\n            margin-right: 5%;\r\n            text-align: justify;\r\n        }\r\n\r\n        .centered-text {\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            margin-top: 20px;\r\n        }\r\n\r\n        .bold {\r\n            font-weight: bold;\r\n            margin-left: 5%;\r\n            margin-right: 5%;\r\n            text-align: justify;\r\n            font-family: \"Arial\", sans-serif;\r\n        }\r\n\r\n        .attachment-table {\r\n            width: 90%;\r\n            border-collapse: collapse;\r\n            margin: 0 auto;\r\n        }\r\n\r\n        .attachment-table th, .attachment-table td {\r\n            border: 1px solid black;\r\n            padding: 10px;\r\n            text-align: left;\r\n            font-family: \"Arial\", sans-serif;\r\n        }\r\n\r\n        .attachment-table th:nth-child(1) {\r\n            width: 5px; \r\n        }\r\n\r\n        .table-container {\r\n            margin-bottom: 0;\r\n        }\r\n\r\n    \u003c/style\u003e\r\n\u003c/head\u003e\r\n\u003cbody lang=\"ms-MY\" link=\"#000080\" vlink=\"#800000\" dir=\"ltr\"\u003e\r\n  \u003cdiv title=\"header\"\u003e\r\n        \u003cp lang=\"ms-MY\" class=\"western\" style=\"margin-bottom: 0.42in;\"\u003e\r\n            \u003cbr/\u003e\r\n        \u003c/p\u003e\r\n    \u003c/div\u003e\r\n\r\n    \u003cdiv\u003e\r\n        \u003cimg src=\"logo_DSIS-removebg-preview.png\" alt=\"Logo\" class=\"logo\"\u003e \r\n    \u003c/div\u003e\r\n\r\n    \u003cp lang=\"ms-MY\" class=\"memo\"\u003e\r\n        \u003cb\u003eMEMO\u003c/b\u003e\r\n    \u003c/p\u003e\r\n\r\n    \u003ctable class=\"table\" cellpadding=\"7\" cellspacing=\"0\"\u003e\r\n        \u003ccol width=\"273\"/\u003e\r\n        \u003ccol width=\"300\"/\u003e\r\n        \u003ctr valign=\"top\"\u003e\r\n            \u003ctd width=\"273\" height=\"20\" style=\"border: 1px solid #030303; padding: 0in 0.08in\"\u003e\r\n                \u003cp lang=\"ms-MY\" class=\"western\" style=\"margin-left: 0.09in;\"\u003e\r\n                    \u003cfont size=\"3\"\u003eNo. xx/xxxx-x/xxx\u003c/font\u003e\r\n                \u003c/p\u003e\r\n            \u003c/td\u003e\r\n            \u003ctd width=\"300\" style=\"border: 1px solid #030303; padding: 0in 0.08in\"\u003e\r\n                \u003cp lang=\"ms-MY\" class=\"western\" style=\"margin-left: 0.09in;\"\u003e\r\n                    \u003cfont size=\"3\"\u003eTanggal XX XXXX XXXX\u003c/font\u003e\r\n                \u003c/p\u003e\r\n            \u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr valign=\"top\"\u003e\r\n            \u003ctd width=\"273\" height=\"19\" style=\"border: 1px solid #030303; padding: 0in 0.08in\"\u003e\r\n                \u003cp lang=\"ms-MY\" class=\"western\" style=\"margin-left: 0.09in;\"\u003e\r\n                    \u003cfont size=\"3\"\u003eDari CSO\u003c/font\u003e\r\n                \u003c/p\u003e\r\n            \u003c/td\u003e\r\n            \u003ctd width=\"300\" style=\"border: 1px solid #030303; padding: 0in 0.08in\"\u003e\r\n                \u003cp lang=\"ms-MY\" class=\"western\" style=\"margin-left: 0.09in;\"\u003e\r\n                    \u003cfont size=\"3\"\u003eKepada xxxx\u003c/font\u003e\r\n                \u003c/p\u003e\r\n            \u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n            \u003ctd colspan=\"2\" width=\"587\" height=\"19\" valign=\"top\" style=\"border: 1px solid #030303; padding: 0in 0.08in\"\u003e\r\n                \u003cp lang=\"ms-MY\" class=\"western\" style=\"margin-left: 0.09in;\"\u003e\r\n                    \u003cfont size=\"3\"\u003eLampiran x Halaman\u003c/font\u003e\r\n                \u003c/p\u003e\r\n            \u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n            \u003ctd colspan=\"2\" width=\"587\" height=\"35\" valign=\"top\" style=\"border: 1px solid #030303; padding: 0in 0.08in\"\u003e\r\n                \u003cp lang=\"ms-MY\" class=\"western\" style=\"text-indent: -1.06in; margin-left: 1.15in;\"\u003e\r\n                    \u003cfont size=\"3\"\u003ePerihal PERMINTAAN TINDAK LANJUT TEMUAN THREAT INTELLIGENCE TERKAIT USER Ivan_test\u003c/font\u003e\r\n                \u003c/p\u003e\r\n            \u003c/td\u003e\r\n        \u003c/tr\u003e\r\n    \u003c/table\u003e\r\n\r\n    \u003cp lang=\"ms-MY\" class=\"western content-text\"\u003e\r\n        \u003cfont size=\"3\"\u003e\u003ci\u003eAssalamualaikum\u003c/i\u003e \u003ci\u003eWarahmatullahi Wabarakatuh\u003c/i\u003e\u003c/font\u003e\r\n    \u003c/p\u003e\r\n\r\n    \u003cp lang=\"ms-MY\" class=\"western content-text\"\u003e\r\n        \u003cfont size=\"3\"\u003eSemoga Bapak/Ibu beserta seluruh jajaran senantiasa dalam keadaan sehat walâafiat dan mendapat taufik serta hidayah dari Allah SWT.\u003c/font\u003e\r\n    \u003c/p\u003e\r\n\r\n    \u003cp lang=\"ms-MY\" class=\"western content-text\"\u003e\r\n        \u003cfont size=\"3\"\u003eBerikut kami sampaikan daftar User ID pengguna Ivan_test yang kami temukan berdasarkan Threat Intelligence.\u003c/font\u003e\r\n    \u003c/p\u003e\r\n\r\n    \u003cp lang=\"ms-MY\" class=\"western content-text\"\u003e\r\n        \u003cfont size=\"3\"\u003eMohon bantuan untuk melakukan hal berikut ini:\u003c/font\u003e\r\n    \u003c/p\u003e\r\n\r\n    \u003col class=\"content-text\"\u003e\r\n        \u003cli\u003e\r\n            \u003cp lang=\"ms-MY\" class=\"western content-text\" align=\"justify\"\u003e\r\n                \u003cfont size=\"3\"\u003eMelakukan verifikasi apakah User ID tersebut valid nasabah Ivan_test.\u003c/font\u003e\r\n            \u003c/p\u003e\r\n        \u003c/li\u003e\r\n        \u003cli\u003e\r\n            \u003cp lang=\"ms-MY\" class=\"western content-text\" align=\"justify\"\u003e\r\n                \u003cfont size=\"3\"\u003eUntuk User ID yang valid, mohon agar segera menjalankan langkah yang diperlukan sesuai ketentuan yang berlaku.\u003c/font\u003e\r\n            \u003c/p\u003e\r\n        \u003c/li\u003e\r\n        \u003cli\u003e\r\n            \u003cp lang=\"ms-MY\" class=\"western content-text\" align=\"justify\"\u003e\r\n                \u003cfont size=\"3\"\u003eMohon untuk mengedukasi nasabah untuk melakukan update antivirus dan melakukan scanning pada endpoint pribadi.\u003c/font\u003e\r\n            \u003c/p\u003e\r\n        \u003c/li\u003e\r\n    \u003c/ol\u003e\r\n\r\n    \u003cp lang=\"ms-MY\" class=\"western content-text\" align=\"justify\"\u003e\r\n        \u003cfont size=\"3\"\u003eInformasi dalam memo ini bersifat rahasia, mohon agar hanya didistribusikan kepada kalangan terbatas sesuai kewenangannya.\u003c/font\u003e\r\n    \u003c/p\u003e\r\n\r\n    \u003cp lang=\"ms-MY\" class=\"western content-text\" align=\"justify\"\u003e\r\n        \u003cfont size=\"3\"\u003eDemikian kami sampaikan. Atas perhatian dan kerjasamanya kami ucapkan terima kasih.\u003c/font\u003e\r\n    \u003c/p\u003e\r\n\r\n    \u003cp lang=\"ms-MY\" class=\"western content-text\" align=\"justify\"\u003e\r\n        \u003cfont size=\"3\"\u003e\u003ci\u003eWassalamualaikum\u003c/i\u003e \u003ci\u003eWarahmatullahi Wabarakatuh\u003c/i\u003e\u003c/font\u003e\r\n    \u003c/p\u003e\r\n\r\n    \u003cdiv lang=\"ms-MY\" class=\"western content-text\" align=\"justify\"\u003e\r\n        \u003cspan class=\"box-left\"\u003e \u003c/span\u003e\r\n        \u003cspan\u003eOFFICE GROUP\u003c/span\u003e\r\n        \u003cspan class=\"box-right\"\u003e \u003c/span\u003e\r\n    \u003c/div\u003e\r\n\r\n    \u003cdiv class=\"yellow-box\"\u003e \u003c/div\u003e\r\n\r\n    \u003cdiv class=\"western content-text\" \u003e\r\n        \u003cfont size=\"3\"\u003e[Nama Lengkap]\u003c/font\u003e\u003cbr\u003e\r\n        \u003cfont size=\"3\"\u003e\u003cb\u003eGROUP HEAD\u003c/b\u003e\u003c/font\u003e\r\n    \u003c/div\u003e\r\n\r\n    \u003cdiv class=\"western content-text\"\u003e\r\n        \u003cfont size=\"3\"\u003eTembusan: [tim1], [tim2]\u003c/font\u003e\r\n    \u003c/div\u003e\r\n\r\n    \u003cp class=\"bold\"\u003eLampiran\u003c/p\u003e\r\n\r\n    \u003ctable class=\"attachment-table\"\u003e\r\n        \u003cthead\u003e\r\n            \u003ctr\u003e\r\n                \u003cth\u003eID\u003c/th\u003e\r\n                \u003cth\u003eName\u003c/th\u003e\r\n                \u003cth\u003eSource Brand\u003c/th\u003e\r\n                \u003cth\u003esla\u003c/th\u003e\r\n                \u003cth\u003eOwner\u003c/th\u003e\r\n                \u003cth\u003eType\u003c/th\u003e\r\n            \u003c/tr\u003e\r\n        \u003c/thead\u003e\r\n        \u003ctbody\u003e\r\n        ----\r\n        \u003c/tbody\u003e\r\n    \u003c/table\u003e\r\n\r\n    \u003cp class=\"content-text\" align=\"center\"\u003e\r\n        \u003cfont size=\"3\"\u003ePermintaan tindak lanjut temuan Threat Intelligence terkait user Ivan_test\u003c/font\u003e\r\n    \u003c/p\u003e\r\n\u003c/body\u003e\r\n\u003c/html\u003e",
